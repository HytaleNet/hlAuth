$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 520);

    #Title {
      Label #TitleLabel {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 36);

      Label #Welcome {
        Text: "";
        Style: (FontSize: 15, TextColor: $C.@ColorDefaultLabel, HorizontalAlignment: Center, Wrap: true);
        Anchor: (Bottom: 12);
      }

      Group #QrHost {
        LayoutMode: Center;
        Anchor: (Bottom: 14);
        Padding: (Vertical: 8, Horizontal: 8);
        Background: #000000(0.3);
      }

      Label #SecretLabel {
        Text: "";
        Style: (RenderBold: true, RenderUppercase: true, TextColor: #94a7bb);
      }

      $C.@TextField #SecretInput {
        Anchor: (Top: 6, Height: 40);
        PlaceholderText: "";
        IsReadOnly: true;
      }

      Label #CodeLabel {
        Text: "";
        Style: (RenderBold: true, RenderUppercase: true, TextColor: #94a7bb);
        Anchor: (Top: 12);
      }

      $C.@TextField #CodeInput {
        Anchor: (Top: 8, Height: 44);
        PlaceholderText: "";
        PasswordChar: "•";
      }

      Label #Error {
        Style: (RenderBold: true, TextColor: #bb3333, HorizontalAlignment: Center, Wrap: true);
        Anchor: (Top: 10);
        Visible: false;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 16, Height: 44);

        $C.@TextButton #ConfirmButton {
          @Sounds = $Sounds.@ButtonsLight;
          Text: "";
          FlexWeight: 1;
          Anchor: (Right: 8);
        }

        $C.@CancelTextButton #CancelButton {
          @Sounds = $Sounds.@ButtonsCancel;
          Text: "";
          FlexWeight: 1;
        }
      }

      Label #Hint {
        Text: "";
        Style: (FontSize: 12, TextColor: $C.@ColorGrayCaption, HorizontalAlignment: Center, Wrap: true);
        Anchor: (Top: 14);
      }
    }
  }
}
